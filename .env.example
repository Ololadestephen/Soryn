# Public origin for same-origin mutation checks. No signing keys are used.
APP_ORIGIN=http://127.0.0.1:3000
# Durable local path; never use local SQLite on ephemeral hosting.
CHOG_DB_PATH=data/local/chog.sqlite
# Public, read-only Monad RPC. Not a wallet signing key or a paid service.
MONAD_RPC_URL=https://rpc.monad.xyz
# Privy dashboard configuration. App/client IDs are public. No app secret is needed.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Optional server-runtime App ID; leave unset to use NEXT_PUBLIC_PRIVY_APP_ID.
# If set for a live instance it must match the frontend's Privy app.
CHOG_PRIVY_SERVER_APP_ID=
# Verification mode: jwks uses Privy's official rotating public signing keys.
PRIVY_VERIFICATION_MODE=jwks
# Optional public PEM for manual pinning; used only when mode is pem.
PRIVY_VERIFICATION_KEY=
